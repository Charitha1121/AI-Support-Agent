# Embedding Provider Configuration
# Supported options: 'local' | 'openai'
# - 'local': Uses deterministic local embeddings (no OpenAI API credits required)
# - 'openai': Uses OpenAI text-embedding-3-small (requires valid OPENAI_API_KEY with credits)
EMBEDDING_PROVIDER=local

# OpenAI API Configuration (Required only when EMBEDDING_PROVIDER=openai or for LLM generation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Server & CORS
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (defaults to backend/app/database/support.db)
DATABASE_URL=sqlite:///./app/database/support.db
